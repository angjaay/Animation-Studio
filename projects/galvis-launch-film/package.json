{
  "name": "galvis-launch-film",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild shared/index.js --bundle --format=iife --global-name=GV --loader:.svg=text --outfile=shared/gv.js --log-level=warning && npm run build:3d",
    "test": "node --test tests/*.test.mjs",
    "pretest": "npm run build",
    "precheck": "npm run build",
    "dev": "npx --yes hyperframes@0.8.181 preview",
    "check": "npx --yes hyperframes@0.8.181 check",
    "render": "npx --yes hyperframes@0.8.181 render --no-browser-gpu",
    "prerender": "npm run build",
    "predev": "npm run build",
    "test:dither": "npm run build && node scripts/compare-dither.mjs",
    "test:animatic": "node --test checks/*.test.mjs",
    "build:3d": "esbuild shared/three/index.js --bundle --format=iife --global-name=GV3D --minify --outfile=shared/gv3d.js --log-level=warning",
    "qa:act": "node scripts/qa-act.mjs",
    "test:film": "node --test checks/film.test.mjs checks/determinism.test.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/mulish": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@turf/rewind": "^7.4.0",
    "d3-geo": "^3.1.1",
    "esbuild": "^0.25.10",
    "gsap": "^3.14.2",
    "pngjs": "^7.0.0",
    "shapefile": "^0.6.6",
    "three": "^0.181.2"
  }
}
